---
import '@fontsource/unifrakturmaguntia/400.css';
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { asset, site } from '../lib/site';

const title = `${site.name} ${site.year} | ${site.dateLong}, ${site.venue}, ${site.city}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(asset('og.jpg'), Astro.site).href : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0B0A0A" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} ${site.year}`} />
    <meta property="og:description" content={site.description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="nojs">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      (function () {
        var burger = document.getElementById('burger'), nav = document.getElementById('nav');
        document.body.classList.remove('nojs');
        function setMenu(o) { nav.classList.toggle('open', o); burger.setAttribute('aria-expanded', o ? 'true' : 'false'); }
        burger.addEventListener('click', function () { setMenu(burger.getAttribute('aria-expanded') !== 'true'); });
        nav.addEventListener('click', function (e) { if (e.target.closest('a')) setMenu(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });
        try {
          var box = document.getElementById('days'), p = box.getAttribute('data-date').split('-');
          var now = new Date(), d = Math.ceil((new Date(+p[0], p[1] - 1, +p[2]) - new Date(now.getFullYear(), now.getMonth(), now.getDate())) / 864e5);
          if (d > 0) { document.getElementById('daysN').textContent = d; box.classList.add('on'); }
        } catch (e) {}
        var els = document.querySelectorAll('.rv');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) { es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }); }, { threshold: 0.08 });
          els.forEach(function (el) { io.observe(el); });
        } else { els.forEach(function (el) { el.classList.add('in'); }); }
      })();
    </script>
  </body>
</html>
