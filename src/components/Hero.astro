---
import { asset, site, ticketHref, ticketAttrs } from '../lib/site';
---
<section class="hero" id="top" aria-labelledby="h1">
  <div class="block" aria-hidden="true"></div>
  <p class="stamp">{site.producedBy} presents</p>
  <h1 id="h1"><img src={asset('logos/slaughterfest-white.png')} width="1600" height="659" alt={site.name} /></h1>
  <div class="hero-facts">
    <div>
      <p class="when">{site.dateLabel}</p>
      <p class="where">{site.venue} &middot; {site.city}</p>
      <p class="prod">Produced by {site.producedBy}</p>
      <p class="days" id="days" data-date={site.date} aria-live="off"><b id="daysN"></b>days to go</p>
    </div>
    <div class="cta-stack">
      <a class="sb" href={ticketHref} {...ticketAttrs}><img src={asset('partners/skillbox-white.png')} width="500" height="500" alt={`Book tickets on ${site.ticketPartner}`} /></a>
      <div class="cta-col">
        <a class="btn" href={ticketHref} {...ticketAttrs}>Book tickets</a>
        <a class="btn ghost" href="#lineup">See the lineup</a>
      </div>
    </div>
  </div>
</section>
